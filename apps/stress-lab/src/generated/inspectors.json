{
  "PlayerWalk": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "collision_errors": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "collision_errors"
    ],
    "title": "PlayerWalk",
    "type": "object"
  },
  "StressConfig": {
    "$defs": {
      "StressScene": {
        "enum": [
          "field",
          "city",
          "metro",
          "dense",
          "highlands"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "bodies": {
        "default": 0,
        "format": "uint32",
        "maximum": 64,
        "minimum": 0,
        "type": "integer"
      },
      "colliders": {
        "default": 1000,
        "format": "uint32",
        "maximum": 10000,
        "minimum": 0,
        "type": "integer"
      },
      "culling": {
        "default": true,
        "type": "boolean"
      },
      "dense_colliders": {
        "default": false,
        "type": "boolean"
      },
      "hierarchy": {
        "default": true,
        "type": "boolean"
      },
      "interpolation": {
        "default": true,
        "type": "boolean"
      },
      "mesh_variety": {
        "default": 8,
        "enum": [
          1,
          8,
          32,
          64
        ],
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "moving_percent": {
        "default": 25,
        "format": "uint32",
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      },
      "queries_per_tick": {
        "default": 32,
        "format": "uint32",
        "maximum": 512,
        "minimum": 0,
        "type": "integer"
      },
      "renderables": {
        "default": 10000,
        "format": "uint32",
        "maximum": 4000000,
        "minimum": 1,
        "type": "integer"
      },
      "scene": {
        "$ref": "#/$defs/StressScene",
        "default": "field"
      },
      "seed": {
        "default": 1337,
        "format": "uint32",
        "maximum": 4294967295,
        "minimum": 0,
        "type": "integer"
      },
      "sensor_percent": {
        "default": 10,
        "format": "uint32",
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      },
      "textured": {
        "default": true,
        "type": "boolean"
      }
    },
    "title": "StressConfig",
    "type": "object"
  },
  "StressMetrics": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "animation_ms": {
        "format": "double",
        "type": "number"
      },
      "last_error": {
        "type": [
          "string",
          "null"
        ]
      },
      "queries_ms": {
        "format": "double",
        "type": "number"
      },
      "query_calls": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "query_errors": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "query_hits": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "sensor_ms": {
        "format": "double",
        "type": "number"
      },
      "sync_post_ms": {
        "format": "double",
        "type": "number"
      },
      "sync_pre_ms": {
        "format": "double",
        "type": "number"
      },
      "total_calls": {
        "type": "string"
      },
      "total_errors": {
        "type": "string"
      },
      "total_hits": {
        "type": "string"
      }
    },
    "required": [
      "sync_pre_ms",
      "sync_post_ms",
      "sensor_ms",
      "queries_ms",
      "animation_ms",
      "query_calls",
      "query_hits",
      "query_errors",
      "total_calls",
      "total_hits",
      "total_errors"
    ],
    "title": "StressMetrics",
    "type": "object"
  }
}
