{
  "BasinDemo": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The fixed demonstration's preparation and authored geometry.",
    "properties": {
      "centers": {
        "items": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "eye": {
        "items": {
          "format": "float",
          "type": "number"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "final_edits": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "heights": {
        "items": {
          "format": "float",
          "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "original_edits": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "ready": {
        "type": "boolean"
      },
      "target": {
        "items": {
          "format": "float",
          "type": "number"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "terrain": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "ready",
      "eye",
      "target",
      "centers",
      "heights",
      "terrain",
      "original_edits",
      "final_edits"
    ],
    "title": "BasinDemoView",
    "type": "object"
  },
  "PlayerWalk": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The authored scene's player's movement queries that failed, which stop\nit rather than move it through geometry.",
    "properties": {
      "collision_errors": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "collision_errors"
    ],
    "title": "PlayerWalk",
    "type": "object"
  },
  "StressConfig": {
    "$defs": {
      "StressScene": {
        "description": "The world a workload builds from its configuration.",
        "oneOf": [
          {
            "const": "field",
            "description": "A grid of towers (the original workload).",
            "type": "string"
          },
          {
            "const": "city",
            "description": "A procedural city of diverse buildings, traffic and machines.",
            "type": "string"
          },
          {
            "const": "metro",
            "description": "The city's plan built with every engine feature: glTF materials over\nprocedural textures, glass, skinned people, keyframed props, lights\nand effects.",
            "type": "string"
          },
          {
            "const": "dense",
            "description": "Boulders and columns of hundreds of thousands of triangles on terrain\ntiles, drawn as virtual geometry from files the page\nfetches.",
            "type": "string"
          },
          {
            "const": "highlands",
            "description": "An 8 km terrain generated by the engine, eroded\nmountains with hand-placed stamps, streamed around the camera; the\nrenderables stand on a plateau.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "A deterministic stress workload. Configuration changes rebuild the\nowned workload outside the frame loop; configurations without `scene`\nbuild the tower field. The bounds are sanity bounds for URLs and the\npage: the engine sets none.",
    "properties": {
      "colliders": {
        "default": 1000,
        "description": "Colliders, at most one per renderable.",
        "format": "uint32",
        "maximum": 10000,
        "minimum": 0,
        "type": "integer"
      },
      "compressed_textures": {
        "default": false,
        "description": "Metro textures as BC7 blocks with their mip chains,\nfor devices with `texture-compression-bc`; RGBA8 otherwise.",
        "type": "boolean"
      },
      "culling": {
        "default": true,
        "description": "Whether frustum culling runs.",
        "type": "boolean"
      },
      "dense_colliders": {
        "default": false,
        "description": "Whether colliders gather in dense clusters past pair budgets.",
        "type": "boolean"
      },
      "hierarchy": {
        "default": true,
        "description": "Whether moving renderables form parent hierarchies.",
        "type": "boolean"
      },
      "interpolation": {
        "default": true,
        "description": "Whether moving renderables interpolate between fixed ticks.",
        "type": "boolean"
      },
      "mesh_variety": {
        "default": 8,
        "description": "Mesh batches the renderables draw from: one of\n[`MESH_VARIETIES`].",
        "enum": [
          1,
          8,
          32,
          64
        ],
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "moving_percent": {
        "default": 25,
        "description": "Share of the renderables that move, in percent.",
        "format": "uint32",
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      },
      "queries_per_tick": {
        "default": 32,
        "description": "Ray, overlap and sweep queries each fixed tick.",
        "format": "uint32",
        "maximum": 512,
        "minimum": 0,
        "type": "integer"
      },
      "renderables": {
        "default": 10000,
        "description": "Renderable objects.",
        "format": "uint32",
        "maximum": 4000000,
        "minimum": 1,
        "type": "integer"
      },
      "scene": {
        "$ref": "#/$defs/StressScene",
        "default": "field",
        "description": "The world the workload builds."
      },
      "seed": {
        "default": 1337,
        "description": "Seed of every random choice the workload makes.",
        "format": "uint32",
        "maximum": 4294967295,
        "minimum": 0,
        "type": "integer"
      },
      "sensor_percent": {
        "default": 10,
        "description": "Share of the colliders that are sensors, in percent.",
        "format": "uint32",
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      },
      "textured": {
        "default": true,
        "description": "Whether materials are textured.",
        "type": "boolean"
      }
    },
    "title": "StressConfig",
    "type": "object"
  },
  "StressMetrics": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The last frame's CPU simulation subsets in milliseconds and the bounded\nspatial query counters, every frame's totals as decimal strings.",
    "properties": {
      "animation_ms": {
        "format": "double",
        "type": "number"
      },
      "last_error": {
        "description": "The last query's error code.",
        "type": [
          "string",
          "null"
        ]
      },
      "queries_ms": {
        "format": "double",
        "type": "number"
      },
      "query_calls": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "query_errors": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "query_hits": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "sensor_ms": {
        "format": "double",
        "type": "number"
      },
      "sync_post_ms": {
        "format": "double",
        "type": "number"
      },
      "sync_pre_ms": {
        "format": "double",
        "type": "number"
      },
      "total_calls": {
        "type": "string"
      },
      "total_errors": {
        "type": "string"
      },
      "total_hits": {
        "type": "string"
      }
    },
    "required": [
      "sync_pre_ms",
      "sync_post_ms",
      "sensor_ms",
      "queries_ms",
      "animation_ms",
      "query_calls",
      "query_hits",
      "query_errors",
      "total_calls",
      "total_hits",
      "total_errors"
    ],
    "title": "StressMetrics",
    "type": "object"
  }
}
