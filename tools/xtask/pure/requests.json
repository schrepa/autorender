{
  "refusals": [
    {"rule": "invalid_json", "path": "$", "source": "{\"op\": \"status\","},
    {"rule": "unknown_field", "path": "$.sky", "request": {"op": "status", "sky": 1}},
    {"rule": "missing_field", "path": "$.origin", "request": {"op": "raycast", "direction": [0, -1, 0], "max_distance": 10}},
    {"rule": "invalid_type", "path": "$", "request": {"op": "inspect", "limit": "three"}},
    {"rule": "unknown_variant", "path": "$.op", "request": {"op": "weather"}},
    {"rule": "invalid_value", "path": "$", "request": {"op": "inspect", "limit": -1}},
    {"rule": "request_too_large", "path": "$", "source": "OVERSIZED"},
    {"rule": "unsupported_version", "path": "$.version", "request": {"op": "status", "version": 2}},
    {"rule": "invalid_page", "path": "$.limit", "request": {"op": "inspect", "component": "Transform", "limit": 0}},
    {"rule": "invalid_selector", "path": "$.parent", "request": {"op": "inspect", "entity": "ground", "parent": "ground"}},
    {"rule": "unknown_inspector", "path": "$.component", "request": {"op": "inspect", "component": "Weather"}},
    {"rule": "invalid_name", "path": "$.component", "request": {"op": "inspect", "component": "not a name!"}},
    {"rule": "unknown_definition", "path": "$.definition", "request": {"op": "describe", "name": "SceneDocument", "definition": "Weather"}},
    {"rule": "no_scene", "path": "$.entity", "scene": "none", "request": {"op": "inspect", "entity": "ground"}},
    {"rule": "unknown_entity", "path": "$.entity", "request": {"op": "inspect", "entity": "nobody"}},
    {"rule": "entity_removed", "path": "$.filter.exclude", "scene": "without ground", "request": {"op": "raycast", "origin": [0, 10, 0], "direction": [0, -1, 0], "max_distance": 20, "filter": {"exclude": "ground"}}},
    {"rule": "wrong_world", "path": "$.scene", "scene": "foreign", "request": {"op": "status"}},
    {"rule": "scan_limit", "path": "$.scene", "scene": "large", "request": {"op": "raycast", "origin": [0, 10, 0], "direction": [0, -1, 0], "max_distance": 20}},
    {"rule": "missing_component", "path": "$.component", "request": {"op": "inspect", "entity": "fountain", "component": "Collider"}},
    {"rule": "missing_resource", "path": "$.assets", "engine": "without assets", "request": {"op": "assets"}},
    {"rule": "missing_plugin", "path": "$.op", "engine": "bare", "request": {"op": "terrain_height", "points": [[0, 0]]}},
    {"rule": "out_of_range", "path": "$.points", "request": {"op": "terrain_height", "points": []}},
    {"rule": "invalid_request", "path": "$.from", "request": {"op": "terrain_route", "from": [0, 0], "to": [10, 10]}},
    {"rule": "unknown_terrain", "path": "$", "request": {"op": "nav_path", "from": [0, 0], "to": [10, 10]}},
    {"rule": "invalid_ray", "path": "$.direction", "request": {"op": "raycast", "origin": [0, 10, 0], "direction": [0, 0, 0], "max_distance": 10}},
    {"rule": "invalid_position", "path": "$.position", "request": {"op": "overlap", "shape": {"kind": "sphere", "radius": 1}, "position": [0, 2000000, 0]}},
    {"rule": "invalid_rotation", "path": "$.rotation", "request": {"op": "overlap", "shape": {"kind": "sphere", "radius": 1}, "position": [0, 0, 0], "rotation": [0, 0, 0, 0]}},
    {"rule": "invalid_shape", "path": "$.shape", "request": {"op": "overlap", "shape": {"kind": "sphere", "radius": 0}, "position": [0, 0, 0]}},
    {"rule": "invalid_benchmark", "path": "$.samples", "stage": "control", "request": {"op": "benchmark", "samples": 0}},
    {"rule": "invalid_presentation_alpha", "path": "$.alpha", "stage": "control", "request": {"op": "capture", "alpha": 2}},
    {"rule": "invalid_revision", "path": "$.revision", "stage": "control", "request": {"op": "reload", "expected_revision": "1", "revision": "02"}},
    {"rule": "pause_required", "path": "$", "stage": "control", "paused": false, "request": {"op": "step", "ticks": 1}},
    {"rule": "duplicate_inspector", "path": "$.name", "stage": "register", "name": "Transform"},
    {"rule": "reserved_inspector", "path": "$.name", "stage": "register", "name": "FrameStats"},
    {"rule": "inspector_too_large", "path": "$.schema", "stage": "register", "name": "Wordy", "description": "words ", "repeat": 200},
    {"rule": "inspector_limit", "path": "$.name", "stage": "register", "name": "Probe", "count": "beyond"},
    {"rule": "source_io", "path": "FILE", "stage": "authoring"},
    {"rule": "invalid_utf8", "path": "FILE", "stage": "authoring", "bytes": [123, 255, 254, 125]},
    {"rule": "invalid_path", "path": "FILE", "stage": "authoring", "target": "root", "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1},
    {"rule": "revision_exhausted", "path": "$.revision", "stage": "authoring", "saved": {"id": "saved", "revision": 1, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": "max"},
    {"rule": "revision_conflict", "path": "$.revision", "stage": "authoring", "saved": {"id": "saved", "revision": 3, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1},
    {"rule": "scene_id_mismatch", "path": "$.id", "stage": "authoring", "saved": {"id": "saved", "revision": 1, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "renamed", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1},
    {"rule": "source_locked", "path": "FILE", "stage": "authoring", "lock": true, "saved": {"id": "saved", "revision": 1, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1}
  ]
}
