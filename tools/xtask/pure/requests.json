{
  "refusals": [
    {"rule": "invalid_json", "path": "$", "source": "{\"verb\": \"query\","},
    {"rule": "unknown_field", "path": "$.args.sky", "request": {"verb": "query", "name": "status", "args": {"sky": 1}}},
    {"rule": "missing_field", "path": "$.args.origin", "request": {"verb": "query", "name": "raycast", "args": {"direction": [0, -1, 0], "max_distance": 10}}},
    {"rule": "invalid_type", "path": "$.limit", "request": {"verb": "inspect", "limit": "three"}},
    {"rule": "unknown_variant", "path": "$.name", "request": {"verb": "query", "name": "weather"}},
    {"rule": "unknown_variant", "path": "$.verb", "request": {"verb": "weather"}},
    {"rule": "invalid_value", "path": "$.limit", "request": {"verb": "inspect", "limit": -1}},
    {"rule": "request_too_large", "path": "$", "source": "OVERSIZED"},
    {"rule": "unsupported_version", "path": "$.version", "request": {"verb": "query", "name": "status", "version": 2}},
    {"rule": "missing_field", "path": "$.version", "source": "{\"verb\": \"query\", \"name\": \"status\"}"},
    {"rule": "invalid_type", "path": "$.version", "request": {"verb": "query", "name": "status", "version": "1"}},
    {"rule": "invalid_page", "path": "$.limit", "request": {"verb": "inspect", "component": "Transform", "limit": 0}},
    {"rule": "invalid_selector", "path": "$.parent", "request": {"verb": "inspect", "entity": "ground", "parent": "ground"}},
    {"rule": "unknown_inspector", "path": "$.component", "request": {"verb": "inspect", "component": "Weather"}},
    {"rule": "invalid_name", "path": "$.component", "request": {"verb": "inspect", "component": "not a name!"}},
    {"rule": "unknown_definition", "path": "$.definition", "request": {"verb": "describe", "name": "SceneDocument", "definition": "Weather"}},
    {"rule": "no_scene", "path": "$.entity", "engine": "bare", "request": {"verb": "inspect", "entity": "ground"}},
    {"rule": "unknown_entity", "path": "$.entity", "request": {"verb": "inspect", "entity": "nobody"}},
    {"rule": "entity_removed", "path": "$.args.filter.exclude", "scene": "without ground", "request": {"verb": "query", "name": "raycast", "args": {"origin": [0, 10, 0], "direction": [0, -1, 0], "max_distance": 20, "filter": {"exclude": "ground"}}}},
    {"rule": "wrong_world", "path": "$.scene", "scene": "foreign", "request": {"verb": "query", "name": "status"}},
    {"rule": "scan_limit", "path": "$.args.scene", "scene": "large", "request": {"verb": "query", "name": "raycast", "args": {"origin": [0, 10, 0], "direction": [0, -1, 0], "max_distance": 20}}},
    {"rule": "missing_component", "path": "$.component", "request": {"verb": "inspect", "entity": "fountain", "component": "Collider"}},
    {"rule": "missing_resource", "path": "$.assets", "engine": "without assets", "request": {"verb": "query", "name": "assets"}},
    {"rule": "missing_plugin", "path": "$.name", "engine": "bare", "request": {"verb": "query", "name": "terrain_height", "args": {"points": [[0, 0]]}}},
    {"rule": "out_of_range", "path": "$.args.points", "request": {"verb": "query", "name": "terrain_height", "args": {"points": []}}},
    {"rule": "invalid_request", "path": "$.args.from", "request": {"verb": "query", "name": "terrain_route", "args": {"from": [0, 0], "to": [10, 10]}}},
    {"rule": "unknown_terrain", "path": "$", "request": {"verb": "query", "name": "nav_path", "args": {"from": [0, 0], "to": [10, 10]}}},
    {"rule": "invalid_ray", "path": "$.args.direction", "request": {"verb": "query", "name": "raycast", "args": {"origin": [0, 10, 0], "direction": [0, 0, 0], "max_distance": 10}}},
    {"rule": "invalid_position", "path": "$.args.position", "request": {"verb": "query", "name": "overlap", "args": {"shape": {"kind": "sphere", "radius": 1}, "position": [0, 2000000, 0]}}},
    {"rule": "invalid_rotation", "path": "$.args.rotation", "request": {"verb": "query", "name": "overlap", "args": {"shape": {"kind": "sphere", "radius": 1}, "position": [0, 0, 0], "rotation": [0, 0, 0, 0]}}},
    {"rule": "invalid_shape", "path": "$.args.shape", "request": {"verb": "query", "name": "overlap", "args": {"shape": {"kind": "sphere", "radius": 0}, "position": [0, 0, 0]}}},
    {"rule": "invalid_benchmark", "path": "$.args.samples", "stage": "control", "request": {"verb": "control", "name": "benchmark", "args": {"samples": 0}}},
    {"rule": "invalid_presentation_alpha", "path": "$.args.alpha", "stage": "control", "request": {"verb": "control", "name": "probe", "args": {"x": 0, "y": 0, "alpha": 2}}},
    {"rule": "invalid_revision", "path": "$.args.revision", "stage": "control", "request": {"verb": "control", "name": "reload", "args": {"expected_revision": "1", "revision": "02"}}},
    {"rule": "pause_required", "path": "$", "stage": "control", "paused": false, "request": {"verb": "control", "name": "step", "args": {"ticks": 1}}},
    {"rule": "duplicate_inspector", "path": "$.name", "stage": "register", "name": "Transform"},
    {"rule": "reserved_inspector", "path": "$.name", "stage": "register", "name": "FrameStats"},
    {"rule": "inspector_too_large", "path": "$.schema", "stage": "register", "name": "Wordy", "description": "words ", "repeat": 3000},
    {"rule": "inspector_limit", "path": "$.name", "stage": "register", "name": "Probe", "count": "beyond"},
    {"rule": "source_io", "path": "FILE", "stage": "authoring"},
    {"rule": "invalid_utf8", "path": "FILE", "stage": "authoring", "bytes": [123, 255, 254, 125]},
    {"rule": "invalid_path", "path": "FILE", "stage": "authoring", "target": "root", "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1},
    {"rule": "revision_exhausted", "path": "$.revision", "stage": "authoring", "saved": {"id": "saved", "revision": 1, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": "max"},
    {"rule": "revision_conflict", "path": "$.revision", "stage": "authoring", "saved": {"id": "saved", "revision": 3, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1},
    {"rule": "scene_id_mismatch", "path": "$.id", "stage": "authoring", "saved": {"id": "saved", "revision": 1, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "renamed", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1},
    {"rule": "source_locked", "path": "FILE", "stage": "authoring", "lock": true, "saved": {"id": "saved", "revision": 1, "materials": [], "meshes": [], "entities": []}, "candidate": {"id": "saved", "revision": 2, "materials": [], "meshes": [], "entities": []}, "expected": 1}
  ]
}
