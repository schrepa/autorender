{
  "name": "browser-engine-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "check": "npm run typecheck && node scripts/check-layers.mjs && node scripts/check-errors.mjs && node scripts/check-parameters.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
