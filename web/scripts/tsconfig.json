{
  // The scripts' types: tsc checks each script that opens with
  // `// @ts-check` (checkJs stays off for the rest), with Node's and the
  // page's declarations. Untyped parameters and caught errors stay `any`,
  // as plain JavaScript has them; everything else is strict.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["*.mjs", "*.d.ts"]
}
