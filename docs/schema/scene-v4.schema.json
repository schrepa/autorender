{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneDocument",
  "description": "A persistent scene source. IDs are authored ASCII names, never runtime IDs.\n\nLoading is bounded to 1 MiB, 10,000 expanded entities, 128 meshes and 256\nmaterials. Prefabs share those scene-wide assets across their placements.\nUnknown fields are rejected to expose authoring mistakes. Arrays retain\nauthored order when serialized, yielding stable, readable source diffs.",
  "type": "object",
  "properties": {
    "camera": {
      "$ref": "#/$defs/SceneCamera",
      "default": {
        "far": 500.0,
        "fov_degrees": 55.0,
        "near": 0.10000000149011612,
        "position": [
          24.0,
          19.0,
          28.0
        ],
        "target": [
          0.0,
          0.0,
          0.0
        ]
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneObject"
      },
      "maxItems": 10000
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneMaterial"
      },
      "maxItems": 256
    },
    "meshes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneMesh"
      },
      "maxItems": 128
    },
    "prefabs": {
      "description": "Reusable local entity trees. Definitions share this document's assets.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenePrefab"
      },
      "maxItems": 128
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "textures": {
      "description": "Decoded opaque sRGB pixels, encoded as base64 only for transport.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneTexture"
      },
      "maxItems": 64
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 4,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "revision",
    "materials",
    "meshes",
    "entities"
  ],
  "$defs": {
    "MeshSource": {
      "description": "Supported geometry recipes, including arbitrary validated triangle meshes.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cube"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Centered unit square in the XZ plane, facing +Y.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plane"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "octahedron"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "maxItems": 98304,
              "minItems": 3
            },
            "kind": {
              "type": "string",
              "const": "inline"
            },
            "vertices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SceneVertex"
              },
              "maxItems": 32768,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "vertices",
            "indices"
          ]
        }
      ]
    },
    "SceneCamera": {
      "description": "Right-handed, Y-up perspective camera. Lens values are in world units.",
      "type": "object",
      "properties": {
        "far": {
          "type": "number",
          "format": "float",
          "default": 500.0,
          "maximum": 1000000.0,
          "minimum": 0.001
        },
        "fov_degrees": {
          "type": "number",
          "format": "float",
          "default": 55.0,
          "maximum": 179.0,
          "minimum": 1.0
        },
        "near": {
          "type": "number",
          "format": "float",
          "default": 0.10000000149011612,
          "maximum": 1000000.0,
          "minimum": 0.001
        },
        "position": {
          "type": "array",
          "default": [
            24.0,
            19.0,
            28.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "target": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "SceneCollider": {
      "description": "A collider or sensor on any authored node, including prefab instance roots.\nZero layer masks are valid and intentionally disable matching pairs.",
      "type": "object",
      "properties": {
        "filter": {
          "type": "integer",
          "format": "uint32",
          "default": 4294967295,
          "minimum": 0
        },
        "memberships": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "sensor": {
          "type": "boolean",
          "default": false
        },
        "shape": {
          "$ref": "#/$defs/SceneColliderShape"
        }
      },
      "additionalProperties": false,
      "required": [
        "shape"
      ]
    },
    "SceneColliderShape": {
      "description": "Explicit local collision geometry. Parent transforms apply as full affine\nmatrices; rendering meshes never supply implicit collider dimensions.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "half_extents": {
              "description": "Positive half sizes on local axes, each in [0.0001, 10000].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "kind": {
              "type": "string",
              "const": "cuboid"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "half_extents"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sphere"
            },
            "radius": {
              "description": "Local radius in [0.0001, 10000]. Nonuniform transforms form ellipsoids.",
              "type": "number",
              "format": "float",
              "maximum": 10000.0,
              "minimum": 0.0001
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "radius"
          ]
        }
      ]
    },
    "SceneMaterial": {
      "description": "One named opaque material; color channels are linear values in `[0, 1]`.",
      "type": "object",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "texture": {
          "description": "Optional authored texture ID; no runtime handle is persisted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "color"
      ]
    },
    "SceneMesh": {
      "description": "A named CPU mesh. Sources contain no filesystem paths or executable data.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "source": {
          "$ref": "#/$defs/MeshSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ]
    },
    "SceneObject": {
      "description": "One local transform, optional renderable, or prefab instance root.\nTags are game-defined startup hook names.",
      "type": "object",
      "properties": {
        "collider": {
          "description": "Local collision shape, independent of rendering. Requires version 4.",
          "anyOf": [
            {
              "$ref": "#/$defs/SceneCollider"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "material": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "mesh": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "description": "Optional display label, at most 128 UTF-8 bytes without control characters.",
          "type": "string",
          "default": "",
          "maxLength": 128
        },
        "parent": {
          "description": "Parent ID in the scene, or in this prefab's local definition.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "prefab": {
          "description": "Named prefab to expand below this transform-only instance root.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "tags": {
          "description": "At most 16 distinct authored IDs, each at most 64 ASCII bytes.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "transform": {
          "$ref": "#/$defs/SceneTransform",
          "default": {
            "rotation_degrees": [
              0.0,
              0.0,
              0.0
            ],
            "scale": [
              1.0,
              1.0,
              1.0
            ],
            "translation": [
              0.0,
              0.0,
              0.0
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ScenePrefab": {
      "description": "A reusable entity tree whose parents reference IDs within the definition.\n\nInstance roots use [`SceneObject::prefab`]. Template roots become children of\nthat instance root. Nested prefab references are deliberately unsupported.",
      "type": "object",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "maxItems": 10000
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "entities"
      ]
    },
    "SceneTexture": {
      "description": "Immutable opaque RGBA8 sRGB pixels in row-major, top-to-bottom order.\n\nPNG/GLB decoding happens offline. Base64 is decoded only during validation\nand loading, never in simulation or rendering. Sampling is linear with\nclamp-to-edge and one mip level. The complete scene still must fit 1 MiB.",
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2048,
          "minimum": 1
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "rgba8": {
          "description": "Canonical padded RFC 4648 base64; each alpha byte must equal 255.",
          "type": "string",
          "maxLength": 1048576
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2048,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height",
        "rgba8"
      ]
    },
    "SceneTransform": {
      "description": "Local transform with Euler XYZ rotation expressed in degrees.\n\nTranslation is bounded to ±1,000,000 world units and each scale component\nto `[0.0001, 10000]`, avoiding singular or overflowing normal transforms.\nParent composition preserves full matrices, including shear. Negative scale\nreflection is not authored by this format.",
      "type": "object",
      "properties": {
        "rotation_degrees": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "scale": {
          "type": "array",
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "translation": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "SceneVertex": {
      "description": "CPU vertex authoring data; the renderer owns its separate upload layout.",
      "type": "object",
      "properties": {
        "normal": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "uv": {
          "description": "Top-left origin texture coordinates, sampled with clamp-to-edge.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "normal"
      ]
    }
  }
}
