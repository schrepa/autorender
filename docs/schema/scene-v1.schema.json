{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneDocument",
  "description": "A persistent scene source. IDs are authored ASCII names, never runtime IDs.\n\nLoading is bounded to 1 MiB, 10,000 entities, 128 meshes and 256 materials.\nUnknown fields are rejected to expose authoring mistakes. Arrays retain\nauthored order when serialized, yielding stable, readable source diffs.",
  "type": "object",
  "properties": {
    "camera": {
      "$ref": "#/$defs/SceneCamera",
      "default": {
        "far": 500.0,
        "fov_degrees": 55.0,
        "near": 0.10000000149011612,
        "position": [
          24.0,
          19.0,
          28.0
        ],
        "target": [
          0.0,
          0.0,
          0.0
        ]
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneObject"
      },
      "maxItems": 10000
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneMaterial"
      },
      "maxItems": 256
    },
    "meshes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneMesh"
      },
      "maxItems": 128
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "revision",
    "materials",
    "meshes",
    "entities"
  ],
  "$defs": {
    "MeshSource": {
      "description": "Supported geometry recipes, including arbitrary validated triangle meshes.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cube"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Centered unit square in the XZ plane, facing +Y.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plane"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "octahedron"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "maxItems": 98304,
              "minItems": 3
            },
            "kind": {
              "type": "string",
              "const": "inline"
            },
            "vertices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SceneVertex"
              },
              "maxItems": 32768,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "vertices",
            "indices"
          ]
        }
      ]
    },
    "SceneCamera": {
      "description": "Right-handed, Y-up perspective camera. Lens values are in world units.",
      "type": "object",
      "properties": {
        "far": {
          "type": "number",
          "format": "float",
          "default": 500.0,
          "maximum": 1000000.0,
          "minimum": 0.001
        },
        "fov_degrees": {
          "type": "number",
          "format": "float",
          "default": 55.0,
          "maximum": 179.0,
          "minimum": 1.0
        },
        "near": {
          "type": "number",
          "format": "float",
          "default": 0.10000000149011612,
          "maximum": 1000000.0,
          "minimum": 0.001
        },
        "position": {
          "type": "array",
          "default": [
            24.0,
            19.0,
            28.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "target": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "SceneMaterial": {
      "description": "One named opaque material; color channels are linear values in `[0, 1]`.",
      "type": "object",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "color"
      ]
    },
    "SceneMesh": {
      "description": "A named CPU mesh. Sources contain no filesystem paths or executable data.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "source": {
          "$ref": "#/$defs/MeshSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ]
    },
    "SceneObject": {
      "description": "One renderable authored entity. Tags are game-defined startup hook names.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "material": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "mesh": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "description": "Optional display label, at most 128 UTF-8 bytes without control characters.",
          "type": "string",
          "default": "",
          "maxLength": 128
        },
        "tags": {
          "description": "At most 16 distinct authored IDs, each at most 64 ASCII bytes.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "transform": {
          "$ref": "#/$defs/SceneTransform",
          "default": {
            "rotation_degrees": [
              0.0,
              0.0,
              0.0
            ],
            "scale": [
              1.0,
              1.0,
              1.0
            ],
            "translation": [
              0.0,
              0.0,
              0.0
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "mesh",
        "material"
      ]
    },
    "SceneTransform": {
      "description": "Local transform with Euler XYZ rotation expressed in degrees.\n\nTranslation is bounded to ±1,000,000 world units and each scale component\nto `[0.0001, 10000]`, avoiding singular or overflowing normal transforms.\nThis milestone has no parent-child hierarchy or negative scale reflection.",
      "type": "object",
      "properties": {
        "rotation_degrees": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "scale": {
          "type": "array",
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "translation": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "SceneVertex": {
      "description": "CPU vertex authoring data; the renderer owns its separate upload layout.",
      "type": "object",
      "properties": {
        "normal": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "normal"
      ]
    }
  }
}
