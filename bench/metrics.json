{
  "note": "Every metric and work counter the engine's measurements report: what each is (kind, statistic, runtimes, unit, direction) and, for work counters, the rule base and candidate follow (equal; not-above: the candidate's no higher; false: in every run; shown). A name ending in * stands for every name with that prefix. Work counters are the frame statistics (FrameStats) by their dotted paths. How a metric is judged (its noise floor, whether it counts as a cost) is the factory's policy. cargo xtask lint holds this file to the names the measurements report.",
  "metrics": [
    {
      "name": "frame_ms_mean",
      "kind": "timing",
      "statistic": "the mean of the sampled frames drawn offscreen one at a time, unpaced, each waiting for its GPU work (CPU and GPU in series), timed by the host from time zero after the run settled and warmed up",
      "runtimes": [
        "native"
      ],
      "unit": "ms",
      "direction": "lower"
    },
    {
      "name": "frame_ms_p95",
      "kind": "timing",
      "statistic": "the 95th percentile of the same frames, interpolated linearly between the two sorted frame times around its rank (engine::host::Distribution): the measure command takes it from each frame's time the run reports, so both arms' come from the tools' code",
      "runtimes": [
        "native"
      ],
      "unit": "ms",
      "direction": "lower"
    },
    {
      "name": "frame_ms_pipelined_mean",
      "kind": "timing",
      "statistic": "the sampled frames drawn again with at most two in flight (each submitted once the GPU drew the frame two before it): the measure command's clock from the host's mark before the first to its mark after the GPU finished the last, over their number",
      "runtimes": [
        "native"
      ],
      "unit": "ms",
      "direction": "lower"
    },
    {
      "name": "wall:frame_ms_mean",
      "kind": "timing",
      "statistic": "frame_ms_mean timed from outside the engine: the measure command's clock from the host's mark before the first sampled frame to its mark after the last, over their number",
      "runtimes": [
        "native"
      ],
      "unit": "ms",
      "direction": "lower"
    },
    {
      "name": "load:prepare_ms",
      "kind": "timing",
      "statistic": "from the host's launch to its first prepared frame: the GPU started, pipelines built and terrain loaded, with time held still",
      "runtimes": [
        "native"
      ],
      "unit": "ms",
      "direction": "lower"
    },
    {
      "name": "gpu:*",
      "kind": "timing",
      "statistic": "a render pass's GPU time from timestamp queries: the median of its samples over the sampled frames, drawn a third time under the engine's capture (profiling builds)",
      "runtimes": [
        "native"
      ],
      "unit": "ms",
      "direction": "lower"
    },
    {
      "name": "cpu:*",
      "kind": "timing",
      "statistic": "an engine span's CPU time: the median over the sampled frames of its milliseconds in each frame (its spans and loop aggregates summed, frames without it counting 0), from the same capture",
      "runtimes": [
        "native"
      ],
      "unit": "ms",
      "direction": "lower"
    },
    {
      "name": "mem:main_stack_peak_bytes",
      "kind": "memory",
      "statistic": "the main thread's committed stack at the end of the run (Windows)",
      "runtimes": [
        "native"
      ],
      "unit": "bytes",
      "direction": "lower"
    },
    {
      "name": "mem:live_requested_bytes",
